index 0000000..4ddfa83
--- /dev/null
+++ b/client/src/WalkMode.ts
@@ -0,0 +1,116 @@
+// Ground-level walk mode (hypersplat patch).
+//
+// The server sends a walkable XY grid in the viser world frame (+Z up) plus a per-cell eye
+// height (SetWalkBoundsMessage, from hypersplat/stream/walk_bounds.py). While walk mode is on,
+// SynchronizedCameraControls moves the camera on the ground plane and clamps it to this grid
+// every frame, so the viewer never leaves the region the training cameras covered.
+import { SetWalkBoundsMessage } from "./WebsocketMessages";
+
+export interface WalkBounds {
+  enabled: boolean;
+  version: number;
+  originX: number;
+  originY: number;
+  cell: number;
+  width: number;
+  height: number;
+  mask: Uint8Array;
+  heights: Float32Array;
+  speed: number;
+  pitchDeg: number;
+  // Flat indices of walkable cells, for snapping a camera that is outside the grid.
+  walkable: Int32Array;
+}
+
+let current: WalkBounds | null = null;
+
+export function setWalkBounds(message: SetWalkBoundsMessage) {
+  const mask = new Uint8Array(message.mask);
+  const walkable: number[] = [];
+  for (let i = 0; i < mask.length; i++) if (mask[i]) walkable.push(i);
+  current = {
+    enabled: message.enabled,
+    version: message.version,
+    originX: message.origin[0],
+    originY: message.origin[1],
+    cell: message.cell,
+    width: message.width,
+    height: message.height,
+    mask,
+    heights: new Float32Array(message.heights),
+    speed: message.speed,
+    pitchDeg: message.pitch_deg,
+    walkable: Int32Array.from(walkable),
+  };
+}
+
+/** Bounds when walk mode is on and usable, else null. */
+export function activeWalkBounds(): WalkBounds | null {
+  return current !== null && current.enabled && current.walkable.length > 0
+    ? current
+    : null;
+}
+
+export function isWalkable(b: WalkBounds, x: number, y: number): boolean {
+  const i = Math.round((x - b.originX) / b.cell);
+  const j = Math.round((y - b.originY) / b.cell);
+  if (i < 0 || j < 0 || i >= b.width || j >= b.height) return false;
+  return b.mask[j * b.width + i] !== 0;
+}
+
+/** Bilinear eye height at world (x, y), clamped to the grid. */
+export function eyeHeight(b: WalkBounds, x: number, y: number): number {
+  const fx = Math.min(Math.max((x - b.originX) / b.cell, 0), b.width - 1);
+  const fy = Math.min(Math.max((y - b.originY) / b.cell, 0), b.height - 1);
+  const i0 = Math.floor(fx);
+  const j0 = Math.floor(fy);
+  const i1 = Math.min(i0 + 1, b.width - 1);
+  const j1 = Math.min(j0 + 1, b.height - 1);
+  const tx = fx - i0;
+  const ty = fy - j0;
+  const h = b.heights;
+  const w = b.width;
+  const top = h[j0 * w + i0] * (1 - tx) + h[j0 * w + i1] * tx;
+  const bot = h[j1 * w + i0] * (1 - tx) + h[j1 * w + i1] * tx;
+  return top * (1 - ty) + bot * ty;
+}
+
+/** World XY of the walkable cell centre nearest to (x, y). */
+export function nearestWalkable(
+  b: WalkBounds,
+  x: number,
+  y: number,
+): [number, number] {
+  let best = -1;
+  let bestD = Infinity;
+  for (let k = 0; k < b.walkable.length; k++) {
+    const idx = b.walkable[k];
+    const cx = b.originX + (idx % b.width) * b.cell;
+    const cy = b.originY + Math.floor(idx / b.width) * b.cell;
+    const d = (cx - x) * (cx - x) + (cy - y) * (cy - y);
+    if (d < bestD) {
+      bestD = d;
+      best = idx;
+    }
+  }
+  return [
+    b.originX + (best % b.width) * b.cell,
+    b.originY + Math.floor(best / b.width) * b.cell,
+  ];
+}
+
+/** Clamp a move from (x0, y0) to (x1, y1): slide along walls instead of stopping dead.
+ * A start outside the grid (new bounds, server-set pose) snaps to the nearest walkable cell. */
+export function clampMove(
+  b: WalkBounds,
+  x0: number,
+  y0: number,
+  x1: number,
+  y1: number,
+): [number, number] {
+  if (!isWalkable(b, x0, y0)) return nearestWalkable(b, x1, y1);
+  if (isWalkable(b, x1, y1)) return [x1, y1];
+  if (isWalkable(b, x1, y0)) return [x1, y0];
+  if (isWalkable(b, x0, y1)) return [x0, y1];
+  return [x0, y0];
+}
